{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome completo"
    },
    "phone": {
      "type": "string",
      "description": "Telefone/WhatsApp"
    },
    "email": {
      "type": "string",
      "description": "E-mail (opcional)"
    },
    "service_interest": {
      "type": "string",
      "description": "Servi\u00e7o de interesse"
    },
    "preferred_time": {
      "type": "string",
      "description": "Melhor hor\u00e1rio para contato"
    },
    "message": {
      "type": "string",
      "description": "Mensagem adicional"
    },
    "source": {
      "type": "string",
      "enum": [
        "Home",
        "Quiz",
        "Servi\u00e7o",
        "Contato"
      ],
      "description": "Origem do lead"
    },
    "quiz_result": {
      "type": "string",
      "description": "Resultado do quiz (se aplic\u00e1vel)"
    },
    "lgpd_consent": {
      "type": "boolean",
      "description": "Consentimento LGPD"
    },
    "status": {
      "type": "string",
      "enum": [
        "Novo",
        "Contatado",
        "Agendado",
        "N\u00e3o interessado"
      ],
      "default": "Novo",
      "description": "Status do lead"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es internas"
    }
  },
  "required": [
    "name",
    "phone",
    "lgpd_consent"
  ]
}