{
  "name": "GalleryImage",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "Ambiente",
        "Resultados"
      ],
      "description": "Categoria da imagem"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para filtros"
    },
    "image": {
      "type": "string",
      "description": "URL da imagem"
    },
    "caption": {
      "type": "string",
      "description": "Legenda"
    },
    "order": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "category",
    "image"
  ]
}